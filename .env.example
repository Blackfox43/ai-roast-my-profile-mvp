# Required: Gemini API key for roast generation.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: AI model name. Keep default unless you know the model you want.
ROAST_MODEL="gemini-3.5-flash"

# Required for production persistence on Vercel/Render/Fly/Cloud Run.
# Use Neon, Supabase Postgres, Railway Postgres, Vercel Postgres, etc.
# Without this, the app uses roasts.local.json for local development only.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional rate limit controls for POST /api/roast.
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="8"

# Optional: test the frontend/backend without calling Gemini. Do not enable in production.
MOCK_AI="false"

# Optional local server port.
PORT="3000"
